# ── Data (MIMIC-IV must NEVER be committed) ──
# Leading slash anchors to repo root — does NOT affect src/data/
/data/
!/data/.gitkeep
!/data/README.md
*.csv
*.csv.gz
*.parquet
*.feather
*.h5
*.hdf5

# Per-admission exports derived from real MIMIC-IV-Note text (verbatim
# quotes + clinical_justification) -- same PhysioNet DUA restriction as the
# *.csv rule above, just in JSON form. Aggregate-only result summaries
# (pipeline_evaluation.json, discordance_sensitivity.json,
# discordance_subgroup_evaluation.json -- counts/metrics only, no note
# excerpts) are NOT covered by this and stay trackable.
models/stage3_full_evaluation_export.json

# ── Model artifacts ──
# Exclude large binaries at any depth under models/
models/**/*.pkl
models/**/*.joblib
models/**/*.pt
models/**/*.pth
models/**/*.bin
models/**/*.safetensors
*.safetensors
*.onnx
# Intermediate training checkpoints (keep only the best model metadata).
# Trailing wildcard also matches src/stage2/train.py's stale-checkpoint
# rename target (models/stage2_checkpoints_stale_<timestamp>/) -- without
# it, a renamed-aside stale checkpoint dir's small metadata files (not
# caught by the *.pt/*.safetensors patterns above -- confirmed 2026-09-10,
# *.pth specifically slipped through until added above too) silently
# become trackable again.
models/stage2_checkpoints*/
# Best model weights (too large for git; store separately or use HuggingFace Hub)
models/stage2_longformer_best/model.safetensors
models/stage2_longformer_best/training_args.bin

# ── Environment / secrets ──
.env
.env.local

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Jupyter ──
.ipynb_checkpoints/

# ── Logs ──
logs/
*.log

# ── OS ──
.DS_Store
Thumbs.db

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── Local MIMIC paths (safety net) ──
mimic-iv/
mimic-iv-note/
physionet.org/
